[Unit]
Description=nexus-rag (container): Sync of the Corpus %i
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
ExecStart=/usr/bin/docker compose --project-name nexus-rag --env-file /etc/nexus-rag/container.env -f /opt/nexus-rag/container/compose.yaml run --rm -T sync nexus-rag sync %i
TimeoutStartSec=6h
SuccessExitStatus=75
