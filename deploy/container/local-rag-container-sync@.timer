# Not enabled by `container start`: opt in per Corpus, for example
#   systemctl enable --now local-rag-container-sync@gitlab.timer
[Unit]
Description=local-rag (container) Sync of the Corpus %i every 15 minutes

[Timer]
OnCalendar=*:0/15
RandomizedDelaySec=60
Persistent=true

[Install]
WantedBy=timers.target
