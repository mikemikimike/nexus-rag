[Unit]
Description=nexus-rag: Sync of the Corpus %i
After=qdrant.service

[Service]
Type=oneshot
User=ragsvc
Group=ragsvc
EnvironmentFile=/etc/nexus-rag/nexus-rag.env
Environment=HOME=/var/lib/ragsvc
Environment=PATH=/usr/local/bin:/usr/bin:/bin
ExecStart=/opt/nexus-rag/venv/bin/nexus-rag sync %i
TimeoutStartSec=6h
SuccessExitStatus=75
