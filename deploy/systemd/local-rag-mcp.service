[Unit]
Description=local-rag shared MCP server (streamable HTTP)
After=network-online.target qdrant.service
Wants=qdrant.service

[Service]
Type=simple
User=ragsvc
Group=ragsvc
EnvironmentFile=/etc/local-rag/local-rag.env
ExecStart=/opt/local-rag/venv/bin/local-rag-mcp
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
