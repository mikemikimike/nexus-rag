[Unit]
Description=Qdrant vector database (nexus-rag)
After=network.target

[Service]
Type=simple
User=ragsvc
Group=ragsvc
WorkingDirectory=/var/lib/qdrant
EnvironmentFile=/etc/nexus-rag/nexus-rag.env
ExecStart=/opt/qdrant/qdrant
Restart=always
RestartSec=3
LimitNOFILE=65536
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
