[Unit]
Description=local-rag: Sync of the Corpus %i
After=qdrant.service

[Service]
Type=oneshot
User=ragsvc
Group=ragsvc
EnvironmentFile=/etc/local-rag/local-rag.env
Environment=HOME=/var/lib/ragsvc
Environment=PATH=/usr/local/bin:/usr/bin:/bin
ExecStart=/opt/local-rag/venv/bin/local-rag sync %i
TimeoutStartSec=6h
SuccessExitStatus=75
