[Unit]
Description=nexus-rag shared MCP server (streamable HTTP)
After=network-online.target qdrant.service
Wants=qdrant.service

[Service]
Type=simple
User=ragsvc
Group=ragsvc
EnvironmentFile=/etc/nexus-rag/nexus-rag.env
ExecStart=/opt/nexus-rag/venv/bin/nexus-rag-mcp
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
