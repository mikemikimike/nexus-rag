[Unit]
Description=local-rag: FULL export (refreshes attachments) and index
After=qdrant.service

[Service]
Type=oneshot
User=ragsvc
Group=ragsvc
WorkingDirectory=/opt/local-rag
RuntimeDirectory=local-rag
RuntimeDirectoryPreserve=yes
Environment=HOME=/var/lib/ragsvc
Environment=PATH=/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/bin/flock /run/local-rag/sync.lock /opt/local-rag/scripts/export_confluence.sh --full
TimeoutStartSec=12h
