[Unit]
Description=local-rag shared MCP server (streamable HTTP)
After=network-online.target qdrant.service
Wants=qdrant.service

[Service]
Type=simple
User=ragsvc
Group=ragsvc
WorkingDirectory=/opt/local-rag
ExecStart=/opt/local-rag/.venv/bin/python /opt/local-rag/mcp_server.py
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
