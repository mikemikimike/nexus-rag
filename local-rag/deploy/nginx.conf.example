# Optional TLS front for the MCP server. Then set MCP_HOST=127.0.0.1 in .env.
server {
    listen 443 ssl;
    server_name rag.corp.local;
    ssl_certificate     /etc/ssl/certs/rag.corp.local.crt;
    ssl_certificate_key /etc/ssl/private/rag.corp.local.key;

    location /mcp {
        proxy_pass http://127.0.0.1:8765;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Authorization $http_authorization;
        proxy_buffering off;          # streaming responses
        proxy_read_timeout 300s;
    }
    location /healthz { proxy_pass http://127.0.0.1:8765; }
}
