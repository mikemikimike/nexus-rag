[Unit]
Description=local-rag: export Confluence (incremental) and index changes
After=qdrant.service

[Service]
Type=oneshot
User=ragsvc
Group=ragsvc
WorkingDirectory=/opt/local-rag
RuntimeDirectory=local-rag
RuntimeDirectoryPreserve=yes
Environment=HOME=/var/lib/ragsvc
Environment=PATH=/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/bin/flock -n /run/local-rag/sync.lock /opt/local-rag/scripts/export_confluence.sh
TimeoutStartSec=6h
