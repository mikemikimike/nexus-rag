# Copy to .env (chmod 600). Read by every component.

# --- Embeddings (+ optional rerank) via your LiteLLM gateway ---
LITELLM_BASE_URL=http://GATEWAY_HOST:4000/v1
LITELLM_API_KEY=sk-local-change-me
RAG_EMBED_MODEL=YOUR-EMBEDDING-MODEL-NAME     # model_name registered in LiteLLM
RAG_EMBED_BATCH=16
# Optional reranker registered in LiteLLM (/v1/rerank, Cohere-style). Empty = disabled.
RAG_RERANK_MODEL=
RAG_RERANK_CANDIDATES=30

# --- Qdrant (runs on this VM, bound to localhost) ---
QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=CHANGE_ME_QDRANT_KEY
RAG_COLLECTION=confluence

# --- Shared MCP server (streamable HTTP) ---
MCP_HOST=0.0.0.0
MCP_PORT=8765
# Comma-separated bearer tokens, one per user/team so you can revoke individually
MCP_TOKENS=CHANGE_ME_MCP_TOKEN
# Optional built-in TLS (or terminate TLS on your internal reverse proxy instead)
# MCP_TLS_CERT=/etc/local-rag/tls/server.crt
# MCP_TLS_KEY=/etc/local-rag/tls/server.key

# --- Retrieval tuning ---
RAG_TOP_K=6
RAG_HYBRID_CANDIDATES=40      # per retriever (dense and BM25) before fusion
RAG_MAX_PER_DOC=2             # max chunks from one page in final results
RAG_CHUNK_TOKENS=400
RAG_CHUNK_OVERLAP=60

# --- Paths ---
RAG_DATA_DIR=./data/confluence_export
RAG_STATE_DIR=./state
RAG_OCR=0
# LIT_BIN=/opt/local-rag/.venv/bin/lit

# --- Confluence CLI (pchuri/confluence-cli), read by the exporter ---
CONFLUENCE_DOMAIN=confluence.corp.local
CONFLUENCE_API_PATH=/rest/api
CONFLUENCE_AUTH_TYPE=bearer
CONFLUENCE_API_TOKEN=your-personal-access-token
CONFLUENCE_READ_ONLY=true
# CONFLUENCE_BIN=/usr/local/bin/confluence
